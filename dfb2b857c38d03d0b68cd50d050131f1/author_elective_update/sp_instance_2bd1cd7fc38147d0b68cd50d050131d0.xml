        <widget_parameters><![CDATA[{
	"html": {
		"value": "<section style=\"font-family: Arial, Helvetica, sans-serif; background: #0b0f0c; color: #ffffff; border-radius: 0; overflow: hidden;\">\r\n<div style=\"padding: 44px 48px; background: linear-gradient(135deg, #0b0f0c 0%, #111812 55%, #1f2a1f 100%); border-bottom: 4px solid #86bc25;\">\r\n<div style=\"max-width: 1120px; margin: 0 auto;\">\r\n<div style=\"display: inline-block; padding: 6px 10px; border: 1px solid rgba(134,188,37,0.45); color: #c8f07a; font-size: 12px; font-weight: bold; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 18px;\">Insurance Claim Portal</div>\r\n<h1 style=\"margin: 0 0 14px; font-size: 42px; line-height: 1.08; font-weight: 800; color: #ffffff;\">Claim Pilot</h1>\r\n<p style=\"margin: 0 0 28px; max-width: 720px; font-size: 18px; line-height: 1.55; color: #d8ded8;\">Submit insurance claims, upload supporting documents, and track claim progress from one secure customer portal.</p>\r\n<div style=\"display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 34px;\"><a style=\"display: inline-block; background: #86bc25; color: #0b0f0c; padding: 13px 18px; font-size: 15px; font-weight: bold; text-decoration: none; border-radius: 4px;\" href=\"?id=sc_cat_item&amp;sys_id=18a0bcf7c30147d0b68cd50d05013103\"> Submit a Claim </a> <a style=\"display: inline-block; background: transparent; color: #ffffff; padding: 12px 18px; font-size: 15px; font-weight: bold; text-decoration: none; border: 1px solid rgba(255,255,255,0.42); border-radius: 4px;\" href=\"?id=claim_pilot_my_claims\"> View My Claims </a> <a style=\"display: inline-block; background: transparent; color: #d8ded8; padding: 12px 18px; font-size: 15px; font-weight: bold; text-decoration: none; border: 1px solid rgba(134,188,37,0.45); border-radius: 4px;\" href=\"?id=claim_pilot_help\"> Get Help </a></div>\r\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px;\">\r\n<div style=\"background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); padding: 16px; border-radius: 6px;\">\r\n<div style=\"color: #86bc25; font-size: 13px; font-weight: bold; margin-bottom: 6px;\">01</div>\r\n<div style=\"font-size: 16px; font-weight: bold; margin-bottom: 5px;\">Submit Details</div>\r\n<div style=\"font-size: 13px; line-height: 1.45; color: #cfd6cf;\">Choose claim type, incident date, severity, region, and claim amount.</div>\r\n</div>\r\n<div style=\"background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); padding: 16px; border-radius: 6px;\">\r\n<div style=\"color: #86bc25; font-size: 13px; font-weight: bold; margin-bottom: 6px;\">02</div>\r\n<div style=\"font-size: 16px; font-weight: bold; margin-bottom: 5px;\">Attach Documents</div>\r\n<div style=\"font-size: 13px; line-height: 1.45; color: #cfd6cf;\">Add invoices, reports, photos, medical files, or other supporting evidence.</div>\r\n</div>\r\n<div style=\"background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); padding: 16px; border-radius: 6px;\">\r\n<div style=\"color: #86bc25; font-size: 13px; font-weight: bold; margin-bottom: 6px;\">03</div>\r\n<div style=\"font-size: 16px; font-weight: bold; margin-bottom: 5px;\">Track Progress</div>\r\n<div style=\"font-size: 13px; line-height: 1.45; color: #cfd6cf;\">Follow claim state from New to Review, Investigation, Approval, or Closure.</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</section>",
